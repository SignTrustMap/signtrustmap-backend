{
  "openapi": "3.1.0",
  "info": {
    "title": "SignTrustMap \u2014 FastAPI (Phase 3: Spatial GIS & Smart Navigation)",
    "description": "Phase 3 spatial services for SignTrustMap.  Flow 6: interactive GIS map (bounding-box sign queries as GeoJSON).  Flow 7: smart-navigation WebSocket stream (proximity + heading-filtered sign alerts, route-point buffering, and alert deduplication).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/spatial/health": {
      "get": {
        "tags": [
          "Spatial GIS",
          "Health"
        ],
        "summary": "Spatial GIS health check",
        "operationId": "spatial_health_api_v1_spatial_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/signs": {
      "get": {
        "tags": [
          "Spatial GIS",
          "Spatial GIS"
        ],
        "summary": "Get verified signs in a bounding box (GeoJSON)",
        "description": "ST_Within + ST_MakeEnvelope query (GIST index). Returns ACTIVE signs as GeoJSON FeatureCollection. Optionally filter by sign_type_id or category_id.",
        "operationId": "get_signs_in_viewport_api_v1_spatial_signs_get",
        "parameters": [
          {
            "name": "min_lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "South boundary",
              "title": "Min Lat"
            },
            "description": "South boundary"
          },
          {
            "name": "min_lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "West boundary",
              "title": "Min Lon"
            },
            "description": "West boundary"
          },
          {
            "name": "max_lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "North boundary",
              "title": "Max Lat"
            },
            "description": "North boundary"
          },
          {
            "name": "max_lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "East boundary",
              "title": "Max Lon"
            },
            "description": "East boundary"
          },
          {
            "name": "sign_type_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by traffic_sign_types.id",
              "title": "Sign Type Id"
            },
            "description": "Filter by traffic_sign_types.id"
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by sign_categories.id",
              "title": "Category Id"
            },
            "description": "Filter by sign_categories.id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJSONFeatureCollection"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/signs/{sign_id}": {
      "get": {
        "tags": [
          "Spatial GIS",
          "Spatial GIS"
        ],
        "summary": "Get full details of a single verified sign",
        "description": "Returns all sign fields plus joined traffic_sign_type metadata (name_vi, name_en, sign_code, category_id). 404 if not found.",
        "operationId": "get_sign_detail_api_v1_spatial_signs__sign_id__get",
        "parameters": [
          {
            "name": "sign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Sign Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/navigation/sessions": {
      "post": {
        "tags": [
          "Spatial Navigation"
        ],
        "summary": "Start a navigation session",
        "description": "Creates navigation_sessions row with PostGIS Points (SRID 4326). Returned id is used as sessionId in WS ticks.",
        "operationId": "create_navigation_session_api_v1_spatial_navigation_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/navigation/sessions/me": {
      "get": {
        "tags": [
          "Spatial Navigation"
        ],
        "summary": "List my navigation sessions (paginated)",
        "operationId": "list_my_sessions_api_v1_spatial_navigation_sessions_me_get",
        "parameters": [
          {
            "name": "driver_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID of the Driver user (users.id)",
              "title": "Driver Id"
            },
            "description": "UUID of the Driver user (users.id)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size (1 to 100)",
              "default": 20,
              "title": "Pagesize"
            },
            "description": "Page size (1 to 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedSessionsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/navigation/sessions/{session_id}": {
      "get": {
        "tags": [
          "Spatial Navigation"
        ],
        "summary": "Get a single navigation session by id",
        "operationId": "get_navigation_session_api_v1_spatial_navigation_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Navigation session UUID",
              "title": "Session Id"
            },
            "description": "Navigation session UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Spatial Navigation"
        ],
        "summary": "End a navigation session (COMPLETED or CANCELED)",
        "description": "Transitions ACTIVE session to terminal state and sets ended_at=NOW(). 404 if not found or already terminal.",
        "operationId": "update_navigation_session_api_v1_spatial_navigation_sessions__session_id__patch",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Navigation session UUID",
              "title": "Session Id"
            },
            "description": "Navigation session UUID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spatial/tiles/offline/packs": {
      "get": {
        "tags": [
