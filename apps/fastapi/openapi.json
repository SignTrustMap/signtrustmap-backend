  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "properties": {
          "driver_id": {
            "type": "string",
            "format": "uuid",
            "title": "Driver Id",
            "description": "UUID of the Driver user (users.id)."
          },
          "origin_latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Origin Latitude"
          },
          "origin_longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Origin Longitude"
          },
          "destination_latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Destination Latitude"
          },
          "destination_longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Destination Longitude"
          }
        },
        "type": "object",
        "required": [
          "driver_id",
          "origin_latitude",
          "origin_longitude",
          "destination_latitude",
          "destination_longitude"
        ],
        "title": "CreateSessionRequest",
        "description": "Body for POST /navigation/sessions."
      },
      "GeoJSONFeature": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
            "title": "Type",
            "default": "Feature"
          },
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "properties": {
            "additionalProperties": true,
            "type": "object",
            "title": "Properties"
          }
        },
        "type": "object",
        "required": [
          "geometry",
          "properties"
        ],
        "title": "GeoJSONFeature"
      },
      "GeoJSONFeatureCollection": {
        "properties": {
          "type": {
            "type": "string",
            "const": "FeatureCollection",
            "title": "Type",
            "default": "FeatureCollection"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/GeoJSONFeature"
            },
            "type": "array",
            "title": "Features"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Total number of features returned."
          }
        },
        "type": "object",
        "required": [
          "features",
          "total"
        ],
        "title": "GeoJSONFeatureCollection"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "stm-fastapi"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          },
          "env": {
            "type": "string",
            "title": "Env"
          }
        },
        "type": "object",
        "required": [
          "env"
        ],
        "title": "HealthResponse"
      },
      "OfflineMapPack": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "countryCode": {
            "type": "string",
            "title": "Countrycode",
            "default": "VN"
          },
          "format": {
            "type": "string",
            "title": "Format",
            "default": "pmtiles"
          },
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "sizeBytes": {
            "type": "integer",
            "title": "Sizebytes"
          },
          "sizeMb": {
            "type": "number",
            "title": "Sizemb"
          },
          "minZoom": {
            "type": "integer",
            "title": "Minzoom",
            "default": 0
          },
          "maxZoom": {
            "type": "integer",
            "title": "Maxzoom",
            "default": 15
          },
          "bounds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bounds"
          },
          "isAvailable": {
            "type": "boolean",
            "title": "Isavailable",
            "default": true
          },
          "lastModified": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastmodified"
          },
          "downloadUrl": {
            "type": "string",
            "title": "Downloadurl"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "region",
          "fileName",
          "sizeBytes",
          "sizeMb",
          "bounds",
          "downloadUrl"
        ],
        "title": "OfflineMapPack"
      },
      "OfflineMapPacksResponse": {
        "properties": {
          "packs": {
            "items": {
              "$ref": "#/components/schemas/OfflineMapPack"
            },
            "type": "array",
            "title": "Packs"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "packs",
          "total"
        ],
        "title": "OfflineMapPacksResponse"
      },
      "PaginatedSessionsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            },
            "type": "array",
            "title": "Items",
            "description": "List of navigation sessions"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total",
            "description": "Total count of sessions for this driver"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "Current page number"
          },
          "pageSize": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Pagesize",
            "description": "Page size"
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Totalpages",
            "description": "Total number of pages"
          }
        },
        "type": "object",
        "required": [
          "total",
          "page",
          "pageSize",
          "totalPages"
        ],
        "title": "PaginatedSessionsResponse"
      },
      "SessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
