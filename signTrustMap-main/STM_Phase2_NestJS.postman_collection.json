{
  "info": {
    "name": "STM Phase 2 - NestJS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 2: Survey Submission (Flow 1 chunked upload via MinIO) + P2P Review Workspace (Flow 4). Prefix /api/v1. Login first via Phase1."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "candidateId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tester@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=null;try{j=pm.response.json()}catch(e){}",
                  "if(j && j.accessToken){pm.collectionVariables.set('token',j.accessToken)}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Survey - Submissions (Flow 1)",
      "item": [
        {
          "name": "Initialize Upload Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/initialize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "initialize"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalFilename\": \"dashcam_2026-08-28.mp4\",\n  \"mediaType\": \"VIDEO\",\n  \"totalSizeBytes\": 52428800,\n  \"totalChunks\": 5,\n  \"checksumExpected\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=null;try{j=pm.response.json()}catch(e){}",
                  "if(j && j.sessionId){pm.collectionVariables.set('sessionId',j.sessionId)}"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Chunk 0 (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/{{sessionId}}/chunks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "{{sessionId}}",
                "chunks"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "chunkIndex",
                  "value": "0",
                  "type": "text"
                },
                {
                  "key": "checksum",
                  "value": "abcd1234",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Upload Chunk 1 (multipart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/{{sessionId}}/chunks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "{{sessionId}}",
                "chunks"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "chunkIndex",
                  "value": "1",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Get Session Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "submissions",
                "{{sessionId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Review Workspace (Flow 4)",
      "item": [
        {
          "name": "Get Review Queue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "queue"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=null;try{j=pm.response.json()}catch(e){}",
                  "if(j && j.items && j.items[0]){pm.collectionVariables.set('candidateId',j.items[0].id)}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Review Queue (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/queue?page=1&pageSize=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "queue"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Vote Approve (1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{candidateId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{candidateId}}",
                "vote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vote\": 1\n}"
            }
          }
        },
        {
          "name": "Vote Reject with Suggested Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{candidateId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{candidateId}}",
                "vote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vote\": -1,\n  \"suggestedSignTypeId\": 2\n}"
            }
          }
        },
        {
          "name": "Vote Duplicate (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{candidateId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reviews",
                "{{candidateId}}",
                "vote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vote\": 1\n}"
            }
          }
        }
      ]
    }
  ]
}