    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (save token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j=null;try{j=pm.response.json()}catch(e){}",
                  "if(j&&j.accessToken){pm.collectionVariables.set('token',j.accessToken);console.log('token saved')}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPassword123\"\n}"
            }
          }
        }
      ]
    },
