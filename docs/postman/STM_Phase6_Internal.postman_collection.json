{
  "info": {"name": "STM Phase 6 - Internal Orchestration", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Internal stubs cho AI teammate. /internal/* can X-Internal-Token: stm_internal_secret_dev. Submission: QUEUED->SYNCHRONIZING->DETECTING->TRACKING->ESTIMATING->CLASSIFYING->COMPLETED. AL: PATCH priority 0..1. Prefix /api/v1."},
  "variable": [{"key": "baseUrl", "value": "http://localhost:3000/api/v1"}, {"key": "token", "value": ""}, {"key": "sessionId", "value": ""}, {"key": "submissionId", "value": ""}, {"key": "candidateId", "value": ""}, {"key": "internalToken", "value": "stm_internal_secret_dev"}],
  "item": [
    {"name": "Auth - Login", "item": [{"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"]}, "body": {"mode": "raw", "raw": "{\"email\": \"tester@example.com\", \"password\": \"Password123\"}"}}}]},
    {"name": "Survey - Flow 2 tracking", "item": [
      {"name": "Create VIDEO_GPX draft", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/submissions", "host": ["{{baseUrl}}"], "path": ["submissions"]}, "body": {"mode": "raw", "raw": "{\"submissionType\":\"VIDEO_GPX\",\"capturedAt\":\"2026-09-08T02:00:00.000Z\",\"coordinateSource\":\"GPX_FILE\"}"}}},
      {"name": "Initialize VIDEO 1 chunk", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/submissions/{{submissionId}}/uploads", "host": ["{{baseUrl}}"], "path": ["submissions","{{submissionId}}","uploads"]}, "body": {"mode": "raw", "raw": "{\"originalFilename\":\"dashcam_001.mp4\",\"mediaType\":\"VIDEO\",\"totalSizeBytes\":1024,\"totalChunks\":1}"}}},
      {"name": "GET status/:submissionId", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/submissions/status/{{submissionId}}", "host": ["{{baseUrl}}"], "path": ["submissions","status","{{submissionId}}"]}}},
      {"name": "GET /submissions/me", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/submissions/me?page=1&pageSize=5", "host": ["{{baseUrl}}"], "path": ["submissions","me"], "query": [{"key":"page","value":"1"},{"key":"pageSize","value":"5"}]}}}
    ]},
    {"name": "Internal - Survey Pipeline stubs", "item": [
      {"name": "PATCH -> SYNCHRONIZING", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/submissions/internal/{{submissionId}}/status", "host": ["{{baseUrl}}"], "path": ["submissions","internal","{{submissionId}}","status"]}, "body": {"mode": "raw", "raw": "{\"status\":\"SYNCHRONIZING\",\"note\":\"GPX-video sync stub\"}"}}},
      {"name": "PATCH -> DETECTING", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/submissions/internal/{{submissionId}}/status", "host": ["{{baseUrl}}"], "path": ["submissions","internal","{{submissionId}}","status"]}, "body": {"mode": "raw", "raw": "{\"status\":\"DETECTING\",\"note\":\"YOLO12 stub\"}"}}},
      {"name": "POST complete + reward", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/submissions/internal/{{submissionId}}/complete", "host": ["{{baseUrl}}"], "path": ["submissions","internal","{{submissionId}}","complete"]}, "body": {"mode": "raw", "raw": "{\"note\":\"completed stub\"}"}}},
      {"name": "PATCH no token expect 401", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{baseUrl}}/submissions/internal/{{submissionId}}/status", "host": ["{{baseUrl}}"], "path": ["submissions","internal","{{submissionId}}","status"]}, "body": {"mode": "raw", "raw": "{\"status\":\"SYNCHRONIZING\"}"}}}
    ]},
    {"name": "Internal - Active Learning Flow 14", "item": [
      {"name": "GET unscored-candidates", "request": {"method": "GET", "header": [{"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/reviews/internal/unscored-candidates?limit=10", "host": ["{{baseUrl}}"], "path": ["reviews","internal","unscored-candidates"], "query": [{"key":"limit","value":"10"}]}}},
      {"name": "PATCH single priority", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/reviews/internal/{{candidateId}}/active-learning-priority", "host": ["{{baseUrl}}"], "path": ["reviews","internal","{{candidateId}}","active-learning-priority"]}, "body": {"mode": "raw", "raw": "{\"priority\":0.85}"}}},
      {"name": "POST bulk priorities", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Internal-Token", "value": "{{internalToken}}"}], "url": {"raw": "{{baseUrl}}/reviews/internal/active-learning-priorities", "host": ["{{baseUrl}}"], "path": ["reviews","internal","active-learning-priorities"]}, "body": {"mode": "raw", "raw": "{\"items\":[{\"candidateId\":\"{{candidateId}}\",\"priority\":0.92}]}"}}},
      {"name": "GET queue verify order", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/reviews/queue?page=1&pageSize=5", "host": ["{{baseUrl}}"], "path": ["reviews","queue"], "query": [{"key":"page","value":"1"},{"key":"pageSize","value":"5"}]}}}
    ]}
  ]
}
