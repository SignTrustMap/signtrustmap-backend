      {
        "id": 207,
        "title": "SSL Certificate Expiration (Days Remaining)",
        "type": "bargauge",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 12,
          "h": 6
        },
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 90,
            "unit": "d",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 14,
                  "color": "yellow"
                },
                {
                  "value": 30,
                  "color": "green"
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "targets": [
          {
            "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400",
            "legendFormat": "{{display_name}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ]
      },
