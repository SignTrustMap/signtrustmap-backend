      {
        "id": 205,
        "title": "Response Latency over Time",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 16,
          "h": 8
        },
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 15
            },
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 1.5,
                  "color": "yellow"
                },
                {
                  "value": 3.0,
                  "color": "red"
                }
              ]
            }
          }
        },
        "targets": [
          {
            "expr": "probe_duration_seconds{job=\"blackbox-http\"}",
            "legendFormat": "{{display_name}} ({{provider}})",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ]
      },
      {
        "id": 206,
        "title": "24h Availability SLA (%)",
        "type": "gauge",
        "gridPos": {
          "x": 16,
          "y": 5,
          "w": 8,
          "h": 8
        },
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "fieldConfig": {
          "defaults": {
            "min": 90,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 95,
                  "color": "yellow"
                },
                {
                  "value": 99,
                  "color": "green"
                }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "targets": [
          {
            "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[24h]) * 100",
            "legendFormat": "{{display_name}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ]
      },
