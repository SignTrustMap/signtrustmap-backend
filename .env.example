DATABASE_URL=postgres://stm_user:stm_password@localhost:5432/signtrustmap
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
# Google OAuth2 (fill for real OAuth flow)
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# MinIO object storage (used for chunked survey uploads and sign crops)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=stm_minio
MINIO_SECRET_KEY=stm_minio_secret_123
MINIO_USE_SSL=false
# Internal service token — used by InternalTokenGuard on /internal/* endpoints
# FastAPI/Celery workers call these routes with this token in X-Internal-Token header
INTERNAL_TOKEN=stm_internal_secret_dev

# AI Inference Service (Jetson Orin TensorRT & early classification)
AI_INFERENCE_URL=https://ai.signmap.site
AI_INFERENCE_TIMEOUT_MS=30000

# Nominatim geocoding client
GEOCODING_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_NOMINATIM_TIMEOUT=5s
GEOCODING_NOMINATIM_USER_AGENT=SignTrustMap/0.1 (local development)
GEOCODING_NOMINATIM_ACCEPT_LANGUAGE=vi,en
GEOCODING_NOMINATIM_CACHE_TTL=10m
GEOCODING_NOMINATIM_MINIMUM_REQUEST_INTERVAL=1s
GEOCODING_NOMINATIM_MAXIMUM_CACHE_ENTRIES=1000

# OSRM routing and route-aware sign lookup
ROUTING_PROVIDER=OSRM
ROUTING_OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_OSRM_PROFILE=driving
ROUTING_OSRM_TIMEOUT=5s
NAVIGATION_SIGN_CORRIDOR_WIDTH_METERS=30
NAVIGATION_SIGN_HEADING_TOLERANCE_DEGREES=45
